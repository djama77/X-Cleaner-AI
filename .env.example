# X Developer App: OAuth 2.0 Authorization Code + PKCE
X_CLIENT_ID=
# Required only for a confidential Web App; keep it server-side
X_CLIENT_SECRET=
# Exact callback URL registered in the X Developer Portal
X_REDIRECT_URI=https://YOUR-VERCEL-DOMAIN/api/x/callback
# Generate 32 random bytes and encode as 64 hexadecimal characters
X_TOKEN_ENCRYPTION_KEY=

# Optional archive classifier
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
